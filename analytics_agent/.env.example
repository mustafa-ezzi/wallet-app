# Copy to analytics_agent/.env and fill in what you need.
# Existing environment variables win over this file.
# Never commit analytics_agent/.env.

# Required. PostgreSQL only. The agent will not read local SQLite.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/wallettrails

# Where the validated report is published. Relative paths start at the repo root.
ANALYTICS_OUTPUT_PATH=analytics.json

# Trailing window length in calendar days (1-366). Default 30.
ANALYTICS_PERIOD_DAYS=30

# Application timezone. Active-user and signup days use this zone.
ANALYTICS_TIMEZONE=Asia/Karachi

# Recorded in the report. The OS scheduler is what actually runs the job.
# 15 2 * * * means 02:15 every day.
ANALYTICS_CRON=15 2 * * *

# Database connect/statement timeout in seconds.
ANALYTICS_DB_TIMEOUT_SECONDS=30

# Replace a lock file only when its pid is no longer running.
# If the pid cannot be read, a lock older than this many seconds is stale.
ANALYTICS_LOCK_STALE_SECONDS=3600

ANALYTICS_CATEGORY_LIMIT=10
ANALYTICS_LOG_LEVEL=INFO
ANALYTICS_LOG_FILE=analytics_agent/logs/analytics-agent.log

# Optional. Leave blank to use the built-in rule-based summary.
# The key is sent only to ANALYTICS_LLM_BASE_URL and is never written to analytics.json.
ANALYTICS_LLM_API_KEY=
ANALYTICS_LLM_BASE_URL=https://api.openai.com/v1
ANALYTICS_LLM_MODEL=gpt-4o-mini
ANALYTICS_LLM_TIMEOUT_SECONDS=20

# Optional overrides.
# ANALYTICS_BACKEND_DIR=backend
# ANALYTICS_LOCK_PATH=
