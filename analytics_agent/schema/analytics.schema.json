    "trends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anomaly_rule",
        "direction",
        "anomalies"
      ],
      "properties": {
        "anomaly_rule": {
          "type": "string",
          "const": "Leave-one-out z-score on each day in the current window. A day is flagged when the other days have non-zero standard deviation and |z| >= 2, or when those days have zero variance and this day differs. Windows shorter than 7 days are not scored."
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "users_new",
            "transaction_activity",
            "income_pkr",
            "expense_pkr"
          ],
          "properties": {
            "users_new": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "flat"
              ]
            },
            "transaction_activity": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "flat"
              ]
            },
            "income_pkr": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "flat"
              ]
            },
            "expense_pkr": {
              "type": "string",
              "enum": [
                "up",
                "down",
                "flat"
              ]
            }
          }
        },
        "anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "metric",
              "value",
              "baseline_mean",
              "z_score",
              "direction"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "metric": {
                "type": "string",
                "enum": [
                  "transactions",
                  "expense_pkr"
                ]
              },
              "value": {
                "type": "number"
              },
              "baseline_mean": {
                "type": "number"
              },
              "z_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "high",
                  "low"
                ]
              }
            }
          }
        }
      }
    },
    "insights": {
