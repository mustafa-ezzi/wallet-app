+    @Suppress("UNCHECKED_CAST")
+    private fun textsFromRemoteViews(views: RemoteViews): List<String> {
+        val out = ArrayList<String>()
+        try {
+            val actionsField = RemoteViews::class.java.getDeclaredField("mActions")
+            actionsField.isAccessible = true
+            val actions = actionsField.get(views) as? List<*> ?: return out
+            for (action in actions) {
+                if (action == null) continue
+                val cls = action.javaClass
+                val methodField = cls.declaredFields.firstOrNull { it.name == "methodName" } ?: continue
+                methodField.isAccessible = true
+                if (methodField.get(action) != "setText") continue
+                val valueField = cls.declaredFields.firstOrNull { it.name == "value" } ?: continue
+                valueField.isAccessible = true
+                val value = valueField.get(action)?.toString()?.trim().orEmpty()
+                if (value.isNotEmpty()) out.add(value)
+            }
+        } catch (e: Exception) {
+            // Framework field names differ on some OEM builds. Standard extras still apply.
+        }
+        return out
+    }
