+                        prefs.edit().putString(KEY, "[]").commit()
+                        val arr = JSONArray(raw)
+                        for (i in 0 until arr.length()) {
+                            val obj = arr.getJSONObject(i)
+                            val map = mutableMapOf<String, Any>()
+                            val keys = obj.keys()
+                            while (keys.hasNext()) {
+                                val k = keys.next()
+                                map[k] = obj.get(k)
