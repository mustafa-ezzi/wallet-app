+    /** Custom notification layouts keep the visible sentence in RemoteViews actions. */
+    private fun remoteViewLines(notification: Notification): String {
+        val views = listOfNotNull(
+            notification.contentView,
+            notification.bigContentView,
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) notification.headsUpContentView else null,
+        )
+        val lines = ArrayList<String>()
+        for (rv in views) {
