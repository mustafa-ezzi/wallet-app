+    private fun uniqueLines(parts: List<String>): List<String> {
+        val out = ArrayList<String>()
+        for (part in parts) {
+            for (raw in part.split('\n')) {
+                val line = raw.trim()
+                if (line.isEmpty()) continue
+                if (out.any { it.equals(line, ignoreCase = true) }) continue
+                out.add(line)
+            }
+        }
+        return out
+    }
