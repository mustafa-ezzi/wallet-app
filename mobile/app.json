{
  "expo": {
    "name": "WalletTrails",
    "slug": "cashtrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wallettrails",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wallettrails.app"
    },
    "android": {
      "package": "com.wallettrails.app",
      "adaptiveIcon": {
        "backgroundColor": "#04333b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow WalletTrails to use Face ID to reveal your balances."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#047857",
          "defaultChannel": "wallettrails-due-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WalletTrailsBalance",
              "label": "WalletTrails Balance",
              "description": "Total balance with live sync — resizes cleanly",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/images/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WalletTrailsMonthFlow",
              "label": "WalletTrails Month Flow",
              "description": "Month in / out / net with a flow bar",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/images/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WalletTrailsWallets",
              "label": "WalletTrails Wallets",
              "description": "Top wallets — shows more when you enlarge it",
              "minWidth": "180dp",
              "minHeight": "140dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "previewImage": "./assets/images/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WalletTrailsQuickGlance",
              "label": "WalletTrails Glance",
              "description": "Compact glance — stacks or goes wide when resized",
              "minWidth": "110dp",
              "minHeight": "70dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "previewImage": "./assets/images/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-sms-listener",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://tranquil-radiance-production.up.railway.app",
      "eas": {
        "projectId": "c7895bac-9652-44e9-a80a-a779737f7f69"
      }
    },
    "owner": "mustafaezzi"
  }
}
